#!/bin/bash

GODOT_EXPORT_TEMPLATE_VERSION="4.7.2.stable"

set -e

GODOT_RELEASE_URL="https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_macos.universal.zip"
GODOT_BINARY_REL="GodotBinary/Godot.app/Contents/MacOS/Godot"
TEMPLATES_DIR="$HOME/Library/Application Support/Godot/export_templates/${GODOT_EXPORT_TEMPLATE_VERSION}"

GODOT_EXPORT_TEMPLATE_URL="https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_export_templates.tpz"

GODOT_ZIP_MARKER="Godot.app"

if [ -e Build/godot.zip ] && ! unzip -l Build/godot.zip 2>/dev/null | grep -q "$GODOT_ZIP_MARKER"; then
    echo "Existing godot.zip does not match host ($HOST_OS); removing."
    rm -f Build/godot.zip
fi

echo "Downloading Godot..."
if [ ! -e Build/godot.zip ]; then
    curl -sfL -o Build/godot.zip "$GODOT_RELEASE_URL"
fi

echo "Downloading export templates..."
if [ ! -e Build/godot_templates.tpz ]; then
    curl -sfL -o Build/godot_templates.tpz "$GODOT_EXPORT_TEMPLATE_URL"
fi

echo "Extracting Godot..."
rm -rf Build/GodotBinary
mkdir -p Build/GodotBinary
( cd Build/GodotBinary && unzip -o -q ../godot.zip )

echo "Extracting export templates..."
mkdir -p "$TEMPLATES_DIR"
unzip -o -j -q Build/godot_templates.tpz -d "$TEMPLATES_DIR"

GODOT="$(realpath Build/${GODOT_BINARY_REL})"
echo "Godot binary path: ${GODOT}"

set +e
"${GODOT}" \
    --disable-render-loop \
    --no-header \
    --headless \
    --script Build/WriteBuildVars.gd
set -e
source Build/build_vars.sh

set +e
"${GODOT}" --headless --path . --import
import_rc=$?
set -e
if [ "$import_rc" -ne 0 ] && [ ! -d .godot ]; then
    echo "Import failed (rc=$import_rc) and .godot/ was not created. Aborting." >&2
    exit 1
fi

set +e
"${GODOT}" --headless --path . \
    --script Build/DownloadPythonRequirements.gd
set -e

mkdir -p "Build/Builds/SnekStudio_MacOS-arm64"
set -e
"${GODOT}" --headless --path . \
		--export-release "macOS-arm64" \
		Build/Builds/SnekStudio_MacOS-arm64/SnekStudio.app
set +e
